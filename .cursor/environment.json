{
  "name": "Hoitopolku.ai",
  "install": "corepack enable && cd app && pnpm install --frozen-lockfile",
  "terminals": [
    {
      "name": "static-demos",
      "command": "python3 -m http.server 8000"
    },
    {
      "name": "react-dev",
      "command": "cd app && ([ -f .env.local ] || cp .env.example .env.local) && pnpm dev"
    }
  ],
  "ports": [
    { "name": "static demos", "port": 8000 },
    { "name": "react dev", "port": 3000 }
  ]
}
