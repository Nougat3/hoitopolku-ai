# Environment variables for development
# Copy this to .env.local and fill in your Supabase credentials

# Supabase Configuration (EU region - Frankfurt)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI API (for LääkäriPRO - handled by Edge Function)
# NEVER expose API keys in client-side code
# SUPABASE_ANTHROPIC_API_KEY=your-anthropic-key (server-side only)
