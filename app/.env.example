VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Vahva tunnistus (Telia / Signicat) — kytke päälle julkaisussa
VITE_STRONG_AUTH_ENABLED=false
VITE_STRONG_AUTH_SHOW_COMING_SOON=true
VITE_STRONG_AUTH_PROVIDER=telia

# Telia OIDC (täytä sopimuksen jälkeen)
# VITE_TELIA_OIDC_ISSUER=https://...
# VITE_TELIA_OIDC_CLIENT_ID=
# VITE_TELIA_OIDC_AUTHORIZE_PATH=/authorize

# Signicat OIDC (vaihtoehto)
# VITE_SIGNICAT_OIDC_ISSUER=https://...
# VITE_SIGNICAT_OIDC_CLIENT_ID=
# VITE_SIGNICAT_OIDC_AUTHORIZE_PATH=/auth/open/connect/authorize
